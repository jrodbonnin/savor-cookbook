{
  "name": "savor-cookbook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:access": "node --test tests/demo-policy.test.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "test:recipes": "node --experimental-strip-types --test tests/recipes-schema.test.mjs",
    "stripe:portal-setup": "node scripts/setup-stripe-portal.mjs",
    "test:billing": "node --test tests/billing.test.mjs",
    "stripe:listen": "node scripts/stripe-listen.mjs"
  },
  "dependencies": {
    "@neondatabase/auth": "0.6.0-beta",
    "@neondatabase/serverless": "^1.2.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "stripe": "^23.1.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": "11.22.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "error"
    }
  }
}
